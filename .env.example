# Copy to .env and fill in. Never commit .env.
#
# ⚠ ESCAPE EVERY LITERAL "$" AS "\$".
# Next.js expands $VAR references when it loads .env, so an unescaped "$" is
# treated as a variable name and silently collapses to an empty string. This
# bites bcrypt hashes ($2b$12$...) and any password containing a "$".
# Quoting does NOT help — the quotes are stripped before expansion.

# --- Database (Neon Postgres, free tier) ---
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# --- Public site origin (optional) ---
# The canonical origin, used for metadataBase, robots.txt and the sitemap. Leave
# it unset on Vercel until a custom domain is attached: VERCEL_PROJECT_PRODUCTION_URL
# is picked up automatically and already points at the production domain. Set it
# once you have your own, with no trailing slash.
NEXT_PUBLIC_SITE_URL=""

# --- Media storage (Cloudflare R2) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public CDN origin serving the bucket. Its hostname is added to
# next.config.ts image remotePatterns, so changing it needs a restart.
R2_PUBLIC_BASE_URL="https://media.example.com"

# --- Single admin account ---
# bcrypt hash of the admin password, never the password itself. Generate with:
#   node scripts/hash-password.mjs "your-password"
# Then escape the dollar signs, as shown:
ADMIN_PASSWORD_HASH="\$2b\$12\$replace.this.with.your.own.60.character.bcrypt.hash.value"
# Session JWT signing key, 32+ characters. Hex, so no escaping needed:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Tests (optional) ---
# The plaintext password matching ADMIN_PASSWORD_HASH above. Only used by the
# Playwright suite, to sign in for the admin tests; leave it unset and those
# tests report themselves as skipped rather than failing.
E2E_ADMIN_PASSWORD=""

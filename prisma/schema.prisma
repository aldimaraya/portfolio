// Prisma 7: the datasource block carries no `url`. The connection string for
// Migrate lives in prisma.config.ts, and the runtime client gets it through the
// Neon driver adapter in src/lib/db.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Photo {
  id       String @id @default(cuid())
  imageUrl String

  // Real pixel dimensions rather than a portrait/landscape enum: the wall needs
  // the aspect ratio to size each polaroid, and orientation derives from it.
  width  Int
  height Int

  // Optional. When set it takes the caption's bold line and the location drops
  // to the meta line beneath it (lib/photo/caption.ts); blank reads as before.
  // Not a filter facet and offered no suggestions — titles are one-offs.
  title    String @default("")
  location String
  camera   String

  // Lens and exposure settings as one structured blob — see PhotoSettings in
  // src/lib/photo/settings.ts. Prefilled from EXIF at upload; every field is an
  // optional free-text string, so a file with no EXIF simply stores blanks.
  settings Json

  // Computed once at upload from a downsampled copy of the image, never
  // recomputed per page load. See src/lib/color/analyze.ts.
  // warmth is the sort key for the colour band: net cool→warm, which stays
  // meaningful on frames where no single hue dominates. avgHue and avgChroma
  // describe the average colour and exist only to paint the load-time
  // placeholder. Defaults cover rows written before OKLab analysis —
  // scripts/recolor-photos.mjs backfills them, and until it runs those rows sort
  // as perfectly neutral.
  avgHue       Float
  avgChroma    Float   @default(0)
  avgLightness Float
  warmth       Float   @default(0)
  isMonochrome Boolean

  // Dead column. Held a hue-confidence score from a short-lived attempt to sort
  // the wall by dominant hue; warmth replaced it. Declared only so `db push`
  // stays additive — dropping it needs --accept-data-loss against the live
  // database, which is not worth it for one derived float. Safe to drop by hand.
  hueStrength Float @default(0)

  // When the photo was taken, not uploaded — see createdAt for that. Prefilled
  // from EXIF DateTimeOriginal at upload time, in src/lib/photo/date.ts, but
  // never recoverable after the fact: prepareUpload (lib/photo/trim-client.ts)
  // deliberately strips EXIF from the stored copy so a photo's GPS coordinates
  // are never published, which means the capture date is gone from the stored
  // bytes too. Null means unknown — every photo uploaded before this column
  // existed, plus any scan with no EXIF to read it from — and has to be typed in
  // by hand rather than backfilled.
  takenAt DateTime?

  createdAt DateTime   @default(now())
  tags      PhotoTag[]

  // Photos carry no manual sort order — wall order is derived entirely from
  // colour, and this index serves that query.
  @@index([isMonochrome, warmth])
}

model Video {
  id             String @id @default(cuid())
  videoUrl       String
  posterImageUrl String
  spriteUrl      String
  spriteFrames   Int    @default(10)

  // Same reasoning as Photo.width/height: the frame must be shaped from the clip
  // before layout, or a vertical video is stretched into a 16:9 box. Defaulted to
  // 0 for clips stored before this existed — see FRAME_FALLBACK_RATIO.
  width  Int @default(0)
  height Int @default(0)

  // How long the clip runs. Measured in the browser at upload time from the same
  // metadata read that drives the sprite sheet (see lib/video/sprite.ts), because
  // there is no server-side video processing anywhere in this pipeline to read it
  // later — and the stored file is never opened again after it reaches R2.
  //
  // Float, not Int: a 90-frame clip at 30fps is 3.0s but a 91-frame one is not,
  // and rounding on the way in would make the roll's running total drift.
  // Defaulted to 0 for clips stored before this column existed, which the UI
  // reads as unknown and simply omits — it cannot be backfilled from anything on
  // the server, so an old clip's length has to be re-derived by re-uploading it
  // or left blank. See scripts/backfill-durations.mjs.
  durationSeconds Float @default(0)

  title String

  // No camera/format/fps/iso here on purpose. Capture settings carry real meaning
  // for stills (see Photo.settings) but not for these clips, so the model stays
  // limited to what the motion page actually renders.
  //
  // Optional: plenty of clips need no blurb beyond their title.
  description String @default("")

  // Manual order *within its roll*, maintained by dragging rows in the admin
  // list rather than typed in by hand. Assigned on create — and on a move to
  // another roll — as (that roll's max + 1), so a clip lands at the end of its
  // roll instead of colliding on 0. Values are only comparable inside one roll.
  sortOrder Int @default(0)

  // Nullable only so `db push` stays additive against rows written before rolls
  // existed; saveVideo refuses a clip without one. scripts/backfill-rolls.mjs
  // files the stragglers, and until it runs they read as belonging to the first
  // roll (lib/video/roll.ts) rather than vanishing from /motion. Restrict, not
  // cascade: deleting a roll must never take its clips — and their R2 objects,
  // which a cascade would orphan — with it.
  rollId String?
  roll   Roll?   @relation(fields: [rollId], references: [id], onDelete: Restrict)

  createdAt DateTime   @default(now())
  tags      VideoTag[]

  @@index([rollId, sortOrder])
}

// A named group of clips, drawn on /motion as its own strip of film. Rolls are
// lettered A, B, C… by position, and a clip's frame code carries its roll's
// letter (01A, 01B…), so reordering rolls renumbers every clip on them.
model Roll {
  id   String @id @default(cuid())
  name String

  // Optional, like Video.description: a roll's name is often enough.
  description String @default("")

  // Manual, like Video.sortOrder, and for the same reason: the sequence is an
  // editorial choice, not something derivable from the clips.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  videos    Video[]

  @@index([sortOrder])
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  markdownContent String
  publishedAt     DateTime @default(now())
  draft           Boolean  @default(true)

  @@index([draft, publishedAt])
}

model Tag {
  id     String     @id @default(cuid())
  name   String     @unique
  photos PhotoTag[]
  videos VideoTag[]
}

model PhotoTag {
  photoId String
  tagId   String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([photoId, tagId])
}

model VideoTag {
  videoId String
  tagId   String
  video   Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
}

// ── Newsletter ──────────────────────────────────────────────────────────────
// Email is sent when something new goes up, not on a calendar: publishing
// enqueues an Announcement, and the daily cron sends everything pending as one
// Dispatch once nothing new has arrived for a while (lib/newsletter/schedule.ts).
// See "Newsletter" in docs/architecture.md.

// What an Announcement points at. Named for the surfaces a subscriber opts into,
// not the tables — "stills" is a Photo, "motion" a Video, "journal" a BlogPost.
enum ContentKind {
  journal
  motion
  stills
}

model Subscriber {
  id    String @id @default(cuid())
  // Stored lowercased and trimmed (lib/newsletter/email.ts), so the unique
  // index is what stops one inbox subscribing twice under two spellings.
  email String @unique

  // The only credential a subscriber has: it is in the confirm link, the manage
  // link and every email's unsubscribe link. There are no accounts. Random, not
  // derived from the id, so a leaked id cannot be turned into someone's link.
  token String @unique

  journal Boolean @default(true)
  motion  Boolean @default(true)
  stills  Boolean @default(true)

  // Null until the confirmation link is followed — nothing is sent to an
  // unconfirmed address but that one email. The cron deletes rows left
  // unconfirmed for a week, so a stranger typing someone else's address in
  // leaves nothing behind.
  confirmedAt   DateTime?
  // When the confirmation email last went out, so re-submitting the form cannot
  // be used to mail-bomb an address (CONFIRM_RESEND_MS).
  confirmSentAt DateTime

  // The last Dispatch this subscriber has been handled for — emailed, or
  // skipped because nothing in it matched their choices. What makes a dispatch
  // resumable: a run that dies halfway, or hits the provider's daily cap, picks
  // up with exactly the subscribers not yet marked.
  lastDispatchId String?

  createdAt DateTime @default(now())

  @@index([confirmedAt])
}

// One piece of content queued to be emailed about. Enqueued by the admin save
// actions on create (and on a post's first publish), never on an edit.
model Announcement {
  id    String      @id @default(cuid())
  kind  ContentKind
  // A Photo, Video or BlogPost id. Deliberately not a foreign key — it points at
  // one of three tables — so a deleted item is dropped when the batch resolves
  // rather than cascaded here.
  refId String

  createdAt DateTime @default(now())

  // Taken out of the batch by hand in /admin/newsletter. Kept rather than
  // deleted so the unique index below still stops it being queued again.
  skipped Boolean @default(false)

  // Null while pending. Restrict, because the alternative (SetNull) would turn
  // deleting old dispatch history into putting already-sent items back in the
  // queue, and the next cron run would email them all again.
  dispatchId String?
  dispatch   Dispatch? @relation(fields: [dispatchId], references: [id], onDelete: Restrict)

  // One announcement per item, ever: unpublishing a post and publishing it
  // again must not email everyone a second time.
  @@unique([kind, refId])
  @@index([dispatchId, skipped])
}

// One send of the pending batch to every subscriber.
model Dispatch {
  id String @id @default(cuid())

  createdAt   DateTime  @default(now())
  // Null while subscribers remain to be handled. An incomplete dispatch is
  // resumed before any new one is started.
  completedAt DateTime?

  // Emails actually handed to the provider, for the admin history.
  sent Int @default(0)

  announcements Announcement[]

  @@index([completedAt])
}
